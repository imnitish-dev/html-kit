{
  "name": "html-scrub",
  "version": "0.1.1",
  "description": "Fast, safe HTML sanitizing and HTML → Markdown. Rust core, native in Node/Bun, WASM in browsers, Deno and edge runtimes.",
  "license": "MIT",
  "type": "module",
  "napi": {
    "binaryName": "html-scrub",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build:native": "napi build --platform --release --features napi --output-dir native --no-js",
    "build:wasm": "cargo build --release --target wasm32-unknown-unknown --features wasm && wasm-bindgen target/wasm32-unknown-unknown/release/html_scrub.wasm --target web --out-dir wasm --out-name html_scrub",
    "build": "npm run build:native && npm run build:wasm",
    "test": "node --test",
    "bench": "node bench/bench.js"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.11.1"
  },
  "engines": {
    "node": ">=20.19"
  },
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "workerd": "./lib/edge.js",
      "edge-light": "./lib/edge.js",
      "deno": "./lib/web.js",
      "browser": "./lib/web.js",
      "node": {
        "import": "./lib/node.mjs",
        "require": "./lib/node.cjs"
      },
      "default": "./lib/web.js"
    }
  },
  "files": [
    "lib",
    "native/*.node",
    "wasm/html_scrub.js",
    "wasm/html_scrub_bg.wasm",
    "index.d.ts",
    "LICENSE",
    "THIRD-PARTY-LICENSES.md"
  ],
  "keywords": [
    "html",
    "sanitize",
    "xss",
    "dompurify",
    "sanitize-html",
    "markdown",
    "html-to-markdown",
    "turndown",
    "wasm",
    "rust",
    "napi",
    "edge",
    "cloudflare-workers"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imnitish-dev/html-scrub.git"
  },
  "homepage": "https://github.com/imnitish-dev/html-scrub#readme",
  "bugs": "https://github.com/imnitish-dev/html-scrub/issues"
}
